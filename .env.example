# ==============================================================================
# Environment & Server
# ==============================================================================
NODE_ENV=development
PORT=5000

# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=watchdog
PG_USER=postgres
PG_PASSWORD=password

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=password
MONGO_DB_NAME=watchdog
MONGO_URI=mongodb://root:password@localhost:27017/watchdog?authSource=admin

# ==============================================================================
# Message Broker Configuration
# ==============================================================================
# RabbitMQ
RABBITMQ_USER=api_user
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=watchdog
RABBITMQ_URL=amqp://api_user:password@localhost:5672/watchdog
RABBITMQ_QUEUE=notifications
RABBITMQ_PUBLISHER_CONFIRMS=false
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# ==============================================================================
# Security & Auth Settings
# ==============================================================================
JWT_SECRET=change_this_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1d

# ==============================================================================
# Rate Limiting & Admin
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=password


